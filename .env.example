# PostgreSQL (local Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce

# Optional override; app prefers POSTGRES_* above when those are set
DATABASE_URL=postgresql+psycopg2://ecommerce:ecommerce@localhost:5432/ecommerce

# dbt (used by the Compose `dbt` service; host is the postgres service name)
DBT_HOST=postgres
DBT_PORT=5432

# Airflow 3.3.1 (shared Postgres, separate metadata DB)
# Built from Dockerfile.airflow (Docker CLI so DAG can run sibling images).
AIRFLOW_IMAGE_NAME=ecommerce-airflow:3.3.1
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8080
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Absolute path to this repo on the host (forward slashes). Required for DAG docker run mounts.
COMPOSE_PROJECT_DIR=C:/Users/you/software_development/ecommerce-data-engineering
COMPOSE_NETWORK=ecommerce-data-engineering_default
PIPELINE_IMAGE=ecommerce-pipeline:latest
DBT_IMAGE=ecommerce-dbt:1.8.2
# Generate a real fernet key for anything beyond local demo, e.g.:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret_change_me
